# Copy to outline/.env and fill in. Never commit the real .env.
# Full reference: Outline's self-hosting docs at https://docs.getoutline.com

# Two different random 32-byte hex strings, e.g. from:  openssl rand -hex 32
SECRET_KEY=generate_a_random_hex_string
UTILS_SECRET=generate_another_random_hex_string

# Postgres password: used by docker-compose.yml for the database container.
# It must match the password inside DATABASE_URL below. Set it before the
# first `docker-compose up` (Postgres only reads it when creating the DB).
OUTLINE_PG_PASSWORD=choose_a_strong_password
DATABASE_URL=postgres://outline:choose_a_strong_password@outline-postgres:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://outline-redis:6379

URL=http://localhost:3002
PORT=3000
FORCE_HTTPS=false
DEPLOYMENT=self
ENABLE_UPDATES=false
DEFAULT_LANGUAGE=en_US
LOG_LEVEL=info

FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=26214400

# Magic-link sign-in emails go to the bundled Mailpit catcher:
# open http://localhost:8025 to read them. No real mail is sent.
EMAIL_ENABLED=true
SMTP_HOST=outline-mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=outline@localhost
SMTP_REPLY_EMAIL=outline@localhost
SMTP_SECURE=false
