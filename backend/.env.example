# Copy to backend/.env and fill in. Never commit the real .env.

# ── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
DB_PATH=./data/nadir.db
CORS_ORIGIN=http://localhost:5173
# Where pasted chat images are stored (default: ./data/uploads)
# UPLOADS_DIR=./data/uploads

# ── Models (optional — each defaults to claude-sonnet-5-5) ───────────────────
# Suggested: Sonnet for the Narrator, Opus for the Architect, Haiku for the rest.
# ANTHROPIC_MODEL_NARRATOR=claude-sonnet-5-5
# ANTHROPIC_MODEL_ARCHITECT=claude-opus-5-5
# ANTHROPIC_MODEL_UXUI=claude-haiku-5-5
# ANTHROPIC_MODEL_ANALYST=claude-haiku-5-5
# How hard each agent thinks: low | medium (default) | high | xhigh | max
# ANTHROPIC_EFFORT_NARRATOR=medium
# ANTHROPIC_EFFORT_ARCHITECT=medium
# ANTHROPIC_EFFORT_UXUI=medium
# ANTHROPIC_EFFORT_ANALYST=medium
# Small model used to auto-title new chats (default: claude-haiku-5-5)
# ANTHROPIC_MODEL_TITLE=
# Small model that writes running chat summaries (default: claude-haiku-5-5)
# ANTHROPIC_MODEL_SUMMARY=
# Model that summarizes finished roundtables (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL_ROUNDTABLE_SUMMARY=

# ── Context management (optional) ───────────────────────────────────────────
# windowed (default): recent turns verbatim + running summary of older ones
# full: every message verbatim
# CONTEXT_STRATEGY=windowed
# Verbatim history kept after each summary update, in tokens (default 20000)
# HISTORY_TOKEN_BUDGET=20000
# Extra history allowed to pile up before the summary is updated (default 10000)
# SUMMARY_BATCH_TOKENS=10000
# Prompt cache lifetime: 5m (default) or 1h (1h writes cost 2x instead of 1.25x)
# CACHE_TTL=5m

# ── Retrieval (optional) ────────────────────────────────────────────────────
# Searches older messages and the wiki for each new chat message. Embeddings
# come from a local Ollama server: `ollama pull qwen3-embedding:0.6b`.
# Without Ollama, retrieval falls back to keyword search.
# RETRIEVAL_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434
# Changing the model re-embeds the whole index in the background.
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# Most excerpts / tokens of excerpts added to one request (defaults 8 / 3000)
# RETRIEVAL_MAX_CHUNKS=8
# RETRIEVAL_TOKEN_BUDGET=3000
# Cosine similarity an excerpt needs (default 0.55, from scripts/eval-retrieval.ts)
# RETRIEVAL_MIN_SIMILARITY=0.55
# How often changed wiki pages are re-indexed, in minutes (default 10)
# RETRIEVAL_WIKI_SYNC_MINUTES=10

# ── Agent tools (chat) — reads run automatically, writes need approval ─────
# AGENT_TOOLS_ENABLED=true
# AGENT_TOOL_MAX_ROUNDS=6

# ── Plane (issue tracker) — needed for the Plane tab and feature sync ───────
PLANE_BASE_URL=http://localhost
PLANE_API_TOKEN=your_plane_api_token
PLANE_WORKSPACE_SLUG=your_workspace_slug
PLANE_PROJECT_ID=your_project_id
# Optional: one Plane user per agent, so edits show who made them (the users
# must be members of the project). Unset agents use PLANE_API_TOKEN; the
# analyst never writes.
# PLANE_TOKEN_NARRATOR=
# PLANE_TOKEN_ARCHITECT=
# PLANE_TOKEN_UXUI=

# ── Outline (wiki) — one API token per agent, created in Outline settings ───
OUTLINE_BASE_URL=http://localhost:3002
OUTLINE_TOKEN_NARRATOR=your_outline_token
OUTLINE_TOKEN_ARCHITECT=your_outline_token
OUTLINE_TOKEN_UXUI=your_outline_token
OUTLINE_TOKEN_ANALYST=your_outline_token

# ── Diagram tool ────────────────────────────────────────────────────────────
DIAGRAM_TOOL_BASE_URL=http://localhost:3010

# ── Data export ("Export data" button) — path to the separate data repo ─────
# DATA_REPO_DIR=D:\nadir-agents-data
