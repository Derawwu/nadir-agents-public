# Copy to backend/.env and fill in. Never commit the real .env.

# ── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
DB_PATH=./data/nadir.db
CORS_ORIGIN=http://localhost:5173
# Where pasted chat images are stored (default: ./data/uploads)
# UPLOADS_DIR=./data/uploads

# ── Models (optional — each defaults to claude-sonnet-4-6) ───────────────────
# ANTHROPIC_MODEL_NARRATOR=
# ANTHROPIC_MODEL_ARCHITECT=
# ANTHROPIC_MODEL_UXUI=
# ANTHROPIC_MODEL_ANALYST=
# Small model used to auto-title new chats (default: claude-haiku-4-5)
# ANTHROPIC_MODEL_TITLE=
# Small model that writes running chat summaries (default: claude-haiku-4-5)
# ANTHROPIC_MODEL_SUMMARY=

# ── Context management (optional) ───────────────────────────────────────────
# windowed (default): recent turns verbatim + running summary of older ones
# full: every message verbatim
# CONTEXT_STRATEGY=windowed
# Verbatim history kept after each summary update, in tokens (default 20000)
# HISTORY_TOKEN_BUDGET=20000
# Extra history allowed to pile up before the summary is updated (default 10000)
# SUMMARY_BATCH_TOKENS=10000
# Prompt cache lifetime: 5m (default) or 1h (1h writes cost 2x instead of 1.25x)
# CACHE_TTL=5m

# ── Plane (issue tracker) — needed for the Plane tab and feature sync ───────
PLANE_BASE_URL=http://localhost
PLANE_API_TOKEN=your_plane_api_token
PLANE_WORKSPACE_SLUG=your_workspace_slug
PLANE_PROJECT_ID=your_project_id

# ── Outline (wiki) — one API token per agent, created in Outline settings ───
OUTLINE_BASE_URL=http://localhost:3002
OUTLINE_TOKEN_NARRATOR=your_outline_token
OUTLINE_TOKEN_ARCHITECT=your_outline_token
OUTLINE_TOKEN_UXUI=your_outline_token
OUTLINE_TOKEN_ANALYST=your_outline_token

# ── Diagram tool ────────────────────────────────────────────────────────────
DIAGRAM_TOOL_BASE_URL=http://localhost:3010

# ── Data export ("Export data" button) — path to the separate data repo ─────
# DATA_REPO_DIR=D:\nadir-agents-data
